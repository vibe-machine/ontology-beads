# Which beads are blocked, and by which open beads?
# Takes every bead that is not closed or pinned and lists each of its blockers that is itself not closed or pinned.
match
  $bead isa Bead, has beadId $id, has title $title;
  isCategorizedBy (categorizedThing: $bead, category: $status);
  $status isa BeadStatus, has name $statusName;
  $statusName != "closed";
  $statusName != "pinned";
  let $blocker in openBlockers($bead);
  $blocker has beadId $blockerId, has title $blockerTitle;
select $id, $title, $blockerId, $blockerTitle;
