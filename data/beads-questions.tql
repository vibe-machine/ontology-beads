put $query26 isa StoredQuery, has storedQueryName "beads/who-added-each-blocks-link-and-when";
update
  $query26 has storedQueryTitle "Who added each blocks link, and when";
  $query26 has storedQueryText "match\n  blocks (predecessor: $first, successor: $then), has linkCreatedBy $who, has linkCreatedAt $when;\n  $first has beadId $firstId;\n  $then has beadId $thenId;\nselect $firstId, $thenId, $who, $when;";
  $query26 has storedPackage "beads";
  $query26 has storedVersion "0.2.0";
