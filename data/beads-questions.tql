  $query44 has storedQueryTitle "On which machine each lease was granted";
  $query44 has storedQueryText "match\n  isAssignmentTo (assignment: $lease, assignmentTarget: $bead);\n  $lease isa Lease, has leaseHolder $holder, has grantedNode $machine;\n  $bead has beadId $id;\nselect $id, $holder, $machine;";
  $query44 has storedPackage "beads";
  $query44 has storedVersion "0.2.0";
  $query44 has storedQueryExplanation "Lists each leased bead with the lease's holder and the machine that granted it.";
put $query45 isa StoredQuery, has storedQueryName "beads/which-statuses-and-types-a-repository-added";
update
  $query45 has storedQueryTitle "Which statuses and types a repository added";
  $query45 has storedQueryText "match\n  {\n    $own isa BeadStatus;\n    let $what = \"status\";\n  } or {\n    $own isa BeadType;\n    let $what = \"type\";\n  };\n  $own has name $name, has isCustom true;\n  try {\n    isCategorizedBy (categorizedThing: $own, category: $group);\n    $group isa StatusCategory, has name $fallsIn;\n  };\nselect $what, $name, $fallsIn;";
  $query45 has storedPackage "beads";
  $query45 has storedVersion "0.2.0";
  $query45 has storedQueryExplanation "Lists the statuses and types marked as a repository's own, and for a status the group it falls in.";
