put $query41 isa StoredQuery, has storedQueryName "beads/which-beads-had-their-text-shortened-when-and-from-what-size";
update
  $query41 has storedQueryTitle "Which beads had their text shortened, when, and from what size";
  $query41 has storedQueryText "match\n  $bead isa Bead, has beadId $id, has compactionLevel $times, has compactedAt $when;\n  try { $bead has compactedAtCommit $commit; };\n  try { $bead has originalSize $sizeBefore; };\nselect $id, $times, $when, $commit, $sizeBefore;";
  $query41 has storedPackage "beads";
  $query41 has storedVersion "0.2.0";
  $query41 has storedQueryExplanation "Lists the beads whose text was shortened, with how many times, when, at which commit and the size before.";
put $query42 isa StoredQuery, has storedQueryName "beads/what-agents-and-tools-did-on-bead-one-40";
update
  $query42 has storedQueryTitle "What agents and tools did on bead one-40";
  $query42 has storedQueryText "match\n  $bead isa Bead, has beadId \"one-40\";\n  $step isa Interaction, has interactionKind $kind, has createdAt $when;\n  isAbout (content: $step, subjectMatter: $bead);\n  try { $step has actor $who; };\n  try { $step has modelName $model; };\n  try { $step has toolName $tool; };\n  try { $step has exitCode $exitCode; };\n  try { $step has errorText $error; };\nsort $when;\nselect $when, $kind, $who, $model, $tool, $exitCode, $error;";
  $query42 has storedPackage "beads";
  $query42 has storedVersion "0.2.0";
  $query42 has storedQueryExplanation "Lists the interactions recorded about bead one-40 in order, with who did it, the model or tool, the exit code and any error.";
put $query43 isa StoredQuery, has storedQueryName "beads/what-happened-to-the-work-on-bead-one-40";
update
  $query43 has storedQueryTitle "What happened to the work on bead one-40";
  $query43 has storedQueryText "match\n  $bead isa Bead, has beadId \"one-40\";\n  $event isa ProvenanceEvent, has occurredAt $when;\n  isAbout (content: $event, subjectMatter: $bead);\n  isCategorizedBy (categorizedThing: $event, category: $eventKind);\n  $eventKind isa ProvenanceKind, has name $kind;\n  try { $event has actor $who; };\n  try { $event has reference $pointsAt; };\nsort $when;\nselect $when, $kind, $who, $pointsAt;";
  $query43 has storedPackage "beads";
  $query43 has storedVersion "0.2.0";
  $query43 has storedQueryExplanation "Lists the provenance events about bead one-40 in the order they happened, with who did each and what it points at.";
