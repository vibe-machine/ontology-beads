  $query36 has storedQueryExplanation "Keeps the beads whose work type is open_competition; a bead with no work type is for one worker.";
put $query37 isa StoredQuery, has storedQueryName "beads/which-beads-are-pinned-and-which-are-templates";
update
  $query37 has storedQueryTitle "Which beads are pinned, and which are templates";
  $query37 has storedQueryText "match\n  $bead isa Bead, has beadId $id, has title $title;\n  {\n    $bead has pinned true;\n    let $kind = \"pinned\";\n  } or {\n    $bead has isTemplate true;\n    let $kind = \"template\";\n  };\nselect $id, $title, $kind;";
  $query37 has storedPackage "beads";
  $query37 has storedVersion "0.2.0";
  $query37 has storedQueryExplanation "Lists the beads marked pinned and the beads marked as templates, saying which each is.";
put $query38 isa StoredQuery, has storedQueryName "beads/which-outside-item-each-bead-stands-for-and-which-system-brought-it-in";
