put $query40 isa StoredQuery, has storedQueryName "beads/which-beads-were-deleted-and-when";
update
  $query40 has storedQueryTitle "Which beads were deleted, and when";
  $query40 has storedQueryText "match\n  $bead isa Bead, has beadId $id, has title $title, has deletedAt $deleted;\nsort $deleted desc;\nselect $id, $title, $deleted;";
  $query40 has storedPackage "beads";
