put $query35 isa StoredQuery, has storedQueryName "beads/which-beads-have-a-due-date-and-their-estimate-and-deferral";
update
  $query35 has storedQueryTitle "Which beads have a due date, and their estimate and deferral";
  $query35 has storedQueryText "match\n  $bead isa Bead, has beadId $id, has dueAt $due;\n  try { $bead has estimatedMinutes $minutes; };\n  try { $bead has deferUntil $putOffUntil; };\nsort $due;\nselect $id, $due, $minutes, $putOffUntil;";
  $query35 has storedPackage "beads";
  $query35 has storedVersion "0.2.0";
  $query35 has storedQueryExplanation "Lists the beads that have a due date, soonest first, with the estimate and the deferral time where recorded.";
