  $query38 has storedQueryTitle "Which outside item each bead stands for, and which system brought it in";
  $query38 has storedQueryText "match\n  $bead isa Bead, has beadId $id, has externalRef $outsideItem;\n  try { $bead has sourceSystem $system; };\nselect $id, $outsideItem, $system;";
  $query38 has storedPackage "beads";
