put $query27 isa StoredQuery, has storedQueryName "beads/what-bead-one-40-tracks-validates-or-relates-to";
update
  $query27 has storedQueryTitle "What bead one-40 tracks, validates or relates to";
  $query27 has storedQueryText "match\n  $bead isa Bead, has beadId \"one-40\";\n  {\n    tracks (referringThing: $bead, referent: $other);\n    let $kind = \"tracks\";\n  } or {\n    validates (recognizingParty: $bead, recognizedThing: $other);\n    let $kind = \"validates\";\n  } or {\n    relatesTo (referringThing: $bead, referent: $other);\n    let $kind = \"relates-to\";\n  };\n  $other has beadId $otherId, has title $otherTitle;\nselect $kind, $otherId, $otherTitle;";
  $query27 has storedPackage "beads";
  $query27 has storedVersion "0.2.0";
  $query27 has storedQueryExplanation "Follows the three kinds of link out of bead one-40 and says which kind each one is.";
put $query28 isa StoredQuery, has storedQueryName "beads/which-beads-duplicate-were-caused-by-or-were-delegated-from-another";
update
  $query28 has storedQueryTitle "Which beads duplicate, were caused by, or were delegated from another";
  $query28 has storedQueryText "match\n  {\n    duplicates (referringThing: $from, referent: $to);\n    let $kind = \"duplicates\";\n  } or {\n    causedBy (triggeredThing: $from, triggeringEvent: $to);\n    let $kind = \"caused-by\";\n  } or {\n    delegatedFrom (derivedThing: $from, basis: $to);\n    let $kind = \"delegated-from\";\n  };\n  $from has beadId $fromId;\n  $to has beadId $toId;\nselect $fromId, $kind, $toId;";
  $query28 has storedPackage "beads";
  $query28 has storedVersion "0.2.0";
  $query28 has storedQueryExplanation "Lists every duplicate, caused-by and delegated-from link as the bead it starts from, the kind, and the bead it points to.";
put $query29 isa StoredQuery, has storedQueryName "beads/which-beads-run-only-if-another-fails-or-wait-for-another-s-children";
update
  $query29 has storedQueryTitle "Which beads run only if another fails, or wait for another's children";
  $query29 has storedQueryText "match\n  {\n    conditionallyBlocks (predecessor: $on, successor: $waiting);\n    let $kind = \"runs only if it fails\";\n  } or {\n    waitsFor (requiringThing: $waiting, requirement: $on);\n    let $kind = \"waits for its children\";\n  };\n  $waiting has beadId $waitingId;\n  $on has beadId $onId;\nselect $waitingId, $kind, $onId;";
  $query29 has storedPackage "beads";
  $query29 has storedVersion "0.2.0";
  $query29 has storedQueryExplanation "Lists the conditional-blocks links and the waits-for links: the waiting bead, the kind, and the bead it depends on.";
put $query30 isa StoredQuery, has storedQueryName "beads/who-approved-authored-or-was-assigned-each-bead-and-what-keeps-a-bead-active";
update
  $query30 has storedQueryTitle "Who approved, authored or was assigned each bead, and what keeps a bead active";
  $query30 has storedQueryText "match\n  {\n    approvedBy (recognizedThing: $bead, recognizingParty: $other);\n    let $kind = \"approved by\";\n  } or {\n    attests (recognizedThing: $bead, recognizingParty: $other);\n    let $kind = \"attested by\";\n  } or {\n    authoredBy (product: $bead, producer: $other);\n    let $kind = \"authored by\";\n  } or {\n    assignedTo (participationContext: $bead, participant: $other);\n    let $kind = \"assigned to\";\n  } or {\n    activeUntil (affectedThing: $bead, effectSource: $other);\n    let $kind = \"active until this closes\";\n  };\n  $bead has beadId $id;\n  $other has beadId $otherId;\nselect $id, $kind, $otherId;";
  $query30 has storedPackage "beads";
  $query30 has storedVersion "0.2.0";
  $query30 has storedQueryExplanation "Lists the approved-by, attests, authored-by, assigned-to and until links: the bead, the kind, and the bead at the other end.";
put $query31 isa StoredQuery, has storedQueryName "beads/which-messages-reply-to-which-and-in-which-conversation";
update
  $query31 has storedQueryTitle "Which messages reply to which, and in which conversation";
  $query31 has storedQueryText "match\n  repliesTo (referringThing: $reply, referent: $message), has threadId $conversation;\n  $reply has beadId $replyId;\n  $message has beadId $messageId;\nselect $conversation, $replyId, $messageId;";
  $query31 has storedPackage "beads";
  $query31 has storedVersion "0.2.0";
  $query31 has storedQueryExplanation "Lists each reply with the message it answers and the conversation the link names.";
put $query32 isa StoredQuery, has storedQueryName "beads/which-beads-are-blocked-by-something-outside-this-repository";
update
  $query32 has storedQueryTitle "Which beads are blocked by something outside this repository";
  $query32 has storedQueryText "match\n  $link isa blocks, links (successor: $bead), has externalTarget $target;\n  $bead has beadId $id;\n  try { $link has linkData $data; };\nselect $id, $target, $data;";
  $query32 has storedPackage "beads";
  $query32 has storedVersion "0.2.0";
  $query32 has storedQueryExplanation "Lists the blocks links whose blocker is outside this repository, with the outside target and any extra data on the link.";
put $query33 isa StoredQuery, has storedQueryName "beads/what-each-gate-waits-for-for-how-long-and-who-is-told";
update
  $query33 has storedQueryTitle "What each gate waits for, for how long, and who is told";
  $query33 has storedQueryText "match\n  $gate isa Bead, has beadId $id;\n  isCategorizedBy (categorizedThing: $gate, category: $gateType);\n  $gateType isa GateType, has name $type;\n  try { $gate has awaitId $waitsFor; };\n  try { $gate has timeoutSeconds $seconds; };\n  try { $gate has waiter $told; };\nselect $id, $type, $waitsFor, $seconds, $told;";
  $query33 has storedPackage "beads";
  $query33 has storedVersion "0.2.0";
  $query33 has storedQueryExplanation "Lists each gate with its type, what it waits for and its time limit; a gate with several people to tell appears once for each.";
put $query34 isa StoredQuery, has storedQueryName "beads/which-beads-implement-specification-spec-export";
update
  $query34 has storedQueryTitle "Which beads implement specification spec-export";
  $query34 has storedQueryText "match\n  $bead isa Bead, has beadId $id, has title $title, has specId \"spec-export\";\nselect $id, $title;";
