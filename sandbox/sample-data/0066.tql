match $bead isa Bead, has beadId "one-42"; $closed isa HistoryEntryType, has name "closed"; insert $entry isa HistoryEntry, has actor "dana", has oldValue "in_progress", has newValue "closed", has createdAt 2026-10-09T16:00:00, has historyComment "Superseded by the CSV export."; isAbout (content: $entry, subjectMatter: $bead); isCategorizedBy (categorizedThing: $entry, category: $closed);
