match $bead isa Bead, has beadId "one-3"; $kind isa HistoryEntryType, has name "status_changed"; insert $entry isa HistoryEntry, has actor "agent-3", has oldValue "open", has newValue "in_progress", has createdAt 2026-11-02T09:00:01; isAbout (content: $entry, subjectMatter: $bead); isCategorizedBy (categorizedThing: $entry, category: $kind);
