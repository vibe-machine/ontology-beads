match $type isa BeadType, has name "gate"; $status isa BeadStatus, has name "open"; $priority isa Priority, has name "P1"; $gateType isa GateType, has name "human"; insert $bead isa Bead, has beadId "one-11", has title "Approve dispatch rollout", has createdAt 2026-11-14T09:00:00; isCategorizedBy (categorizedThing: $bead, category: $type); isCategorizedBy (categorizedThing: $bead, category: $status); isCategorizedBy (categorizedThing: $bead, category: $priority); isCategorizedBy (categorizedThing: $bead, category: $gateType);
