match $parent isa Bead, has beadId "one-40"; $writer isa Bead, has beadId "one-45"; $check isa Bead, has beadId "one-46"; $fallback isa Bead, has beadId "one-47"; insert childOf (part: $writer, whole: $parent), has linkCreatedBy "companion", has linkCreatedAt 2026-11-19T10:01:00; childOf (part: $check, whole: $parent), has linkCreatedBy "agent-3", has linkCreatedAt 2026-11-19T10:06:00; blocks (predecessor: $writer, successor: $check), has linkCreatedBy "agent-3", has linkCreatedAt 2026-11-19T10:07:00; conditionallyBlocks (predecessor: $writer, successor: $fallback), has linkCreatedBy "agent-3", has linkCreatedAt 2026-11-19T10:11:00;
