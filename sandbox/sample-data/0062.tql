match $bead isa Bead, has beadId "one-40"; $claim isa ProvenanceKind, has name "claim"; $commit isa ProvenanceKind, has name "commit"; insert $first isa ProvenanceEvent, has provenanceId "prov-0001", has actor "agent-3", has provenanceSource "bd", has occurredAt 2026-11-19T13:55:00, has createdAt 2026-11-19T13:55:01; $second isa ProvenanceEvent, has provenanceId "prov-0002", has actor "agent-3", has reference "9f2c1ab7", has referenceKind "commit", has payload "{\"files\":3}", has provenanceSource "git-hook", has occurredAt 2026-11-19T14:30:00, has createdAt 2026-11-19T14:30:02; isAbout (content: $first, subjectMatter: $bead); isAbout (content: $second, subjectMatter: $bead); isCategorizedBy (categorizedThing: $first, category: $claim); isCategorizedBy (categorizedThing: $second, category: $commit);
