match $type isa BeadType, has name "bug"; $status isa BeadStatus, has name "open"; $priority isa Priority, has name "P0"; $label isa BeadLabel, has name "ux"; insert $bead isa Bead, has beadId "one-5", has title "Tree loses scroll position", has createdAt 2026-11-12T09:00:00; isCategorizedBy (categorizedThing: $bead, category: $type); isCategorizedBy (categorizedThing: $bead, category: $status); isCategorizedBy (categorizedThing: $bead, category: $priority); isCategorizedBy (categorizedThing: $bead, category: $label);
