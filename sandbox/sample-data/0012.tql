match $type isa BeadType, has name "gate"; $status isa BeadStatus, has name "closed"; $priority isa Priority, has name "P1"; $gateType isa GateType, has name "human"; insert $bead isa Bead, has beadId "one-12", has title "Approve tree design", has createdAt 2026-08-08T09:00:00, has closedAt 2026-08-12T11:00:00, has closeReason "Approved"; isCategorizedBy (categorizedThing: $bead, category: $type); isCategorizedBy (categorizedThing: $bead, category: $status); isCategorizedBy (categorizedThing: $bead, category: $priority); isCategorizedBy (categorizedThing: $bead, category: $gateType);
