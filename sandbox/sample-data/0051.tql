match $type isa BeadType, has name "feature"; $status isa BeadStatus, has name "open"; $priority isa Priority, has name "P2"; $workType isa WorkType, has name "open_competition"; insert $bead isa Bead, has beadId "one-40", has title "Export the plan to CSV", has createdAt 2026-11-19T09:00:00, has createdBy "companion", has specId "spec-export", has estimatedMinutes 90, has dueAt 2026-11-28T17:00:00, has deferUntil 2026-11-21T09:00:00, has externalRef "gh-212", has sourceSystem "github", has freeFormData "{\"reviewer\":\"dana\"}"; isCategorizedBy (categorizedThing: $bead, category: $type); isCategorizedBy (categorizedThing: $bead, category: $status); isCategorizedBy (categorizedThing: $bead, category: $priority); isCategorizedBy (categorizedThing: $bead, category: $workType);
