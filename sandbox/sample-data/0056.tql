match $type isa BeadType, has name "task"; $status isa BeadStatus, has name "open"; $priority isa Priority, has name "P2"; insert $a isa Bead, has beadId "one-45", has title "Write the CSV writer", has createdAt 2026-11-19T10:00:00, has createdBy "companion"; $b isa Bead, has beadId "one-46", has title "Check the CSV against the plan", has createdAt 2026-11-19T10:05:00, has createdBy "agent-3"; $c isa Bead, has beadId "one-47", has title "Fall back to a plain text export", has createdAt 2026-11-19T10:10:00, has createdBy "agent-3"; $d isa Bead, has beadId "one-48", has title "Export the plan as CSV (again)", has createdAt 2026-11-19T10:15:00, has createdBy "companion"; isCategorizedBy (categorizedThing: $a, category: $type); isCategorizedBy (categorizedThing: $a, category: $status); isCategorizedBy (categorizedThing: $a, category: $priority); isCategorizedBy (categorizedThing: $b, category: $type); isCategorizedBy (categorizedThing: $b, category: $status); isCategorizedBy (categorizedThing: $b, category: $priority); isCategorizedBy (categorizedThing: $c, category: $type); isCategorizedBy (categorizedThing: $c, category: $status); isCategorizedBy (categorizedThing: $c, category: $priority); isCategorizedBy (categorizedThing: $d, category: $type); isCategorizedBy (categorizedThing: $d, category: $status); isCategorizedBy (categorizedThing: $d, category: $priority);
