match $bead isa Bead, has beadId "one-3"; $kind isa HistoryEntryType, has name "reopened"; insert $entry isa HistoryEntry, has actor "robert@example.com", has createdAt 2026-11-09T10:00:00; isAbout (content: $entry, subjectMatter: $bead); isCategorizedBy (categorizedThing: $entry, category: $kind);
