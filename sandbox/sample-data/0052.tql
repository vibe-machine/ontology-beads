match $type isa BeadType, has name "gate"; $status isa BeadStatus, has name "open"; $priority isa Priority, has name "P2"; $gateType isa GateType, has name "gh:pr"; insert $bead isa Bead, has beadId "one-41", has title "Wait for the export pull request", has createdAt 2026-11-19T09:05:00, has createdBy "dana", has awaitId "482", has timeoutSeconds 86400, has waiter "dana", has waiter "agent-3"; isCategorizedBy (categorizedThing: $bead, category: $type); isCategorizedBy (categorizedThing: $bead, category: $status); isCategorizedBy (categorizedThing: $bead, category: $priority); isCategorizedBy (categorizedThing: $bead, category: $gateType);
