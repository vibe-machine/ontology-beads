match $type isa BeadType, has name "task"; $status isa BeadStatus, has name "pinned"; $priority isa Priority, has name "P4"; insert $bead isa Bead, has beadId "one-43", has title "How we name branches", has createdAt 2026-11-01T09:00:00, has createdBy "dana", has pinned true; isCategorizedBy (categorizedThing: $bead, category: $type); isCategorizedBy (categorizedThing: $bead, category: $status); isCategorizedBy (categorizedThing: $bead, category: $priority);
