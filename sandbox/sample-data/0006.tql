match $type isa BeadType, has name "task"; $status isa BeadStatus, has name "in_progress"; $priority isa Priority, has name "P2"; insert $bead isa Bead, has beadId "one-6", has title "Wire Plan data layer", has owner "robert@example.com", has assignee "agent-7", has createdAt 2026-09-20T09:00:00, has startedAt 2026-09-30T09:00:00, has updatedAt 2026-10-01T12:00:00; isCategorizedBy (categorizedThing: $bead, category: $type); isCategorizedBy (categorizedThing: $bead, category: $status); isCategorizedBy (categorizedThing: $bead, category: $priority);
