match $type isa BeadType, has name "task"; $status isa BeadStatus, has name "open"; $priority isa Priority, has name "P1"; $label isa BeadLabel, has name "ux"; insert $bead isa Bead, has beadId "one-4", has title "Collapse and expand nodes", has createdAt 2026-08-10T09:30:00; isCategorizedBy (categorizedThing: $bead, category: $type); isCategorizedBy (categorizedThing: $bead, category: $status); isCategorizedBy (categorizedThing: $bead, category: $priority); isCategorizedBy (categorizedThing: $bead, category: $label);
