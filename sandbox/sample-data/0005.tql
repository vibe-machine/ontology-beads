match $type isa BeadType, has name "task"; $status isa BeadStatus, has name "closed"; $priority isa Priority, has name "P2"; $label isa BeadLabel, has name "ux"; insert $bead isa Bead, has beadId "one-3", has title "Render tree rows", has description "Render one row per bead in the Plan tree.", has design "Use a virtual list keyed by bead id.", has acceptanceCriteria "Every bead under an epic shows as one row with its status.", has notes "Row height fixed at 28px.", has owner "robert@example.com", has assignee "agent-3", has createdAt 2026-08-10T09:00:00, has startedAt 2026-11-02T09:00:00, has closedAt 2026-11-10T16:00:00, has closeReason "Rows render from the Plan data layer", has updatedAt 2026-11-10T16:00:00; isCategorizedBy (categorizedThing: $bead, category: $type); isCategorizedBy (categorizedThing: $bead, category: $status); isCategorizedBy (categorizedThing: $bead, category: $priority); isCategorizedBy (categorizedThing: $bead, category: $label);
