match $type isa BeadType, has name "task"; $status isa BeadStatus, has name "open"; $priority isa Priority, has name "P1"; $label isa BeadLabel, has name "backend"; insert $bead isa Bead, has beadId "one-13", has title "Add heartbeat endpoint", has createdAt 2026-11-03T09:00:00; isCategorizedBy (categorizedThing: $bead, category: $type); isCategorizedBy (categorizedThing: $bead, category: $status); isCategorizedBy (categorizedThing: $bead, category: $priority); isCategorizedBy (categorizedThing: $bead, category: $label);
