match $type isa BeadType, has name "wave"; $status isa BeadStatus, has name "open"; $priority isa Priority, has name "P2"; $label isa BeadLabel, has name "tvm:wave=running"; insert $bead isa Bead, has beadId "one-15", has title "Wave 2026-11-18", has createdAt 2026-11-18T08:00:00; isCategorizedBy (categorizedThing: $bead, category: $type); isCategorizedBy (categorizedThing: $bead, category: $status); isCategorizedBy (categorizedThing: $bead, category: $priority); isCategorizedBy (categorizedThing: $bead, category: $label);
