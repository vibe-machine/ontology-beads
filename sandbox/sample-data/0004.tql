match $type isa BeadType, has name "feature"; $status isa BeadStatus, has name "in_progress"; $priority isa Priority, has name "P1"; insert $bead isa Bead, has beadId "one-2", has title "Bead tree view", has assignee "robert@example.com", has createdAt 2026-08-05T09:00:00, has startedAt 2026-11-01T09:00:00, has updatedAt 2026-11-15T10:00:00; isCategorizedBy (categorizedThing: $bead, category: $type); isCategorizedBy (categorizedThing: $bead, category: $status); isCategorizedBy (categorizedThing: $bead, category: $priority);
