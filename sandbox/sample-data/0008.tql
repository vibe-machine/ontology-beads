match $type isa BeadType, has name "feature"; $status isa BeadStatus, has name "open"; $priority isa Priority, has name "P3"; insert $bead isa Bead, has beadId "one-8", has title "Wave filters", has createdAt 2026-09-02T09:00:00; isCategorizedBy (categorizedThing: $bead, category: $type); isCategorizedBy (categorizedThing: $bead, category: $status); isCategorizedBy (categorizedThing: $bead, category: $priority);
