match $type isa BeadType, has name "bug"; $status isa BeadStatus, has name "deferred"; $priority isa Priority, has name "P3"; insert $bead isa Bead, has beadId "one-18", has title "Dark mode tree colors", has createdAt 2026-09-15T09:00:00; isCategorizedBy (categorizedThing: $bead, category: $type); isCategorizedBy (categorizedThing: $bead, category: $status); isCategorizedBy (categorizedThing: $bead, category: $priority);
