match $bead isa Bead, has beadId "one-3"; $kind isa HistoryEntryType, has name "claimed"; insert $entry isa HistoryEntry, has actor "agent-3", has newValue "agent-3", has createdAt 2026-11-02T09:00:00; isAbout (content: $entry, subjectMatter: $bead); isCategorizedBy (categorizedThing: $entry, category: $kind);
