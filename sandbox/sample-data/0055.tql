match $type isa BeadType, has name "task"; $status isa BeadStatus, has name "open"; $priority isa Priority, has name "P4"; insert $bead isa Bead, has beadId "one-44", has title "Release checklist", has createdAt 2026-11-01T09:10:00, has createdBy "dana", has isTemplate true; isCategorizedBy (categorizedThing: $bead, category: $type); isCategorizedBy (categorizedThing: $bead, category: $status); isCategorizedBy (categorizedThing: $bead, category: $priority);
