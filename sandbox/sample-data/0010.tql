match $type isa BeadType, has name "feature"; $status isa BeadStatus, has name "closed"; $priority isa Priority, has name "P2"; insert $bead isa Bead, has beadId "one-10", has title "Live holder list", has createdAt 2026-10-02T09:00:00, has closedAt 2026-11-05T15:00:00, has closeReason "Shipped in Plan 0.4"; isCategorizedBy (categorizedThing: $bead, category: $type); isCategorizedBy (categorizedThing: $bead, category: $status); isCategorizedBy (categorizedThing: $bead, category: $priority);
