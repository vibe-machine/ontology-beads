match $type isa BeadType, has name "epic"; $status isa BeadStatus, has name "open"; $priority isa Priority, has name "P1"; $label isa BeadLabel, has name "tvm:component:plan"; insert $bead isa Bead, has beadId "one-1", has title "Plan screen", has description "A tree of all beads with their status and blockers.", has owner "robert@example.com", has createdAt 2026-08-01T09:00:00, has updatedAt 2026-11-15T10:00:00; isCategorizedBy (categorizedThing: $bead, category: $type); isCategorizedBy (categorizedThing: $bead, category: $status); isCategorizedBy (categorizedThing: $bead, category: $priority); isCategorizedBy (categorizedThing: $bead, category: $label);
