match $type isa BeadType, has name "epic"; $status isa BeadStatus, has name "open"; $priority isa Priority, has name "P2"; $label isa BeadLabel, has name "tvm:component:dispatch"; insert $bead isa Bead, has beadId "one-9", has title "Working Now screen", has createdAt 2026-10-01T09:00:00; isCategorizedBy (categorizedThing: $bead, category: $type); isCategorizedBy (categorizedThing: $bead, category: $status); isCategorizedBy (categorizedThing: $bead, category: $priority); isCategorizedBy (categorizedThing: $bead, category: $label);
