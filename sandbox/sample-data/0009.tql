match $type isa BeadType, has name "feature"; $status isa BeadStatus, has name "open"; $priority isa Priority, has name "P2"; insert $bead isa Bead, has beadId "one-7", has title "Wave view", has createdAt 2026-09-01T09:00:00; isCategorizedBy (categorizedThing: $bead, category: $type); isCategorizedBy (categorizedThing: $bead, category: $status); isCategorizedBy (categorizedThing: $bead, category: $priority);
