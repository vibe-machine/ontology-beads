match $type isa BeadType, has name "bug"; $status isa BeadStatus, has name "open"; $priority isa Priority, has name "P1"; $label isa BeadLabel, has name "backend"; insert $bead isa Bead, has beadId "one-16", has title "Lease expiry off by one", has createdAt 2026-11-18T10:00:00; isCategorizedBy (categorizedThing: $bead, category: $type); isCategorizedBy (categorizedThing: $bead, category: $status); isCategorizedBy (categorizedThing: $bead, category: $priority); isCategorizedBy (categorizedThing: $bead, category: $label);
