match $type isa BeadType, has name "task"; $status isa BeadStatus, has name "in_progress"; $priority isa Priority, has name "P2"; $label isa BeadLabel, has name "tvm:agent=active"; insert $bead isa Bead, has beadId "one-14", has title "Write reclaim runbook", has owner "robert@example.com", has assignee "agent-3", has createdAt 2026-11-16T09:00:00, has startedAt 2026-11-18T09:00:00, has updatedAt 2026-11-18T09:20:00; isCategorizedBy (categorizedThing: $bead, category: $type); isCategorizedBy (categorizedThing: $bead, category: $status); isCategorizedBy (categorizedThing: $bead, category: $priority); isCategorizedBy (categorizedThing: $bead, category: $label);
