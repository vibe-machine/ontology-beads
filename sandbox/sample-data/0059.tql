match $type isa BeadType, has name "message"; $status isa BeadStatus, has name "open"; $priority isa Priority, has name "P3"; $feature isa Bead, has beadId "one-40"; insert $ask isa Bead, has beadId "one-49", has title "Should the export include closed beads?", has createdAt 2026-11-19T12:00:00, has createdBy "agent-3"; $answer isa Bead, has beadId "one-50", has title "Yes, with a column for the close reason", has createdAt 2026-11-19T12:20:00, has createdBy "dana"; isCategorizedBy (categorizedThing: $ask, category: $type); isCategorizedBy (categorizedThing: $ask, category: $status); isCategorizedBy (categorizedThing: $ask, category: $priority); isCategorizedBy (categorizedThing: $answer, category: $type); isCategorizedBy (categorizedThing: $answer, category: $status); isCategorizedBy (categorizedThing: $answer, category: $priority); repliesTo (referringThing: $answer, referent: $ask), has threadId "one-49", has linkCreatedBy "dana", has linkCreatedAt 2026-11-19T12:20:00; approvedBy (recognizedThing: $feature, recognizingParty: $answer), has linkCreatedBy "dana", has linkCreatedAt 2026-11-19T12:21:00; attests (recognizedThing: $feature, recognizingParty: $ask), has linkCreatedBy "agent-3", has linkCreatedAt 2026-11-19T12:22:00; authoredBy (product: $answer, producer: $ask), has linkCreatedBy "dana", has linkCreatedAt 2026-11-19T12:23:00; assignedTo (participationContext: $feature, participant: $ask), has linkCreatedBy "dana", has linkCreatedAt 2026-11-19T12:24:00;
