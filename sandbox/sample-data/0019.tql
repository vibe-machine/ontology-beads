match $type isa BeadType, has name "wave"; $status isa BeadStatus, has name "closed"; $priority isa Priority, has name "P2"; $label isa BeadLabel, has name "tvm:wave=done"; insert $bead isa Bead, has beadId "one-19", has title "Wave 2026-11-10", has createdAt 2026-11-10T08:00:00, has closedAt 2026-11-11T08:00:00, has closeReason "All members closed"; isCategorizedBy (categorizedThing: $bead, category: $type); isCategorizedBy (categorizedThing: $bead, category: $status); isCategorizedBy (categorizedThing: $bead, category: $priority); isCategorizedBy (categorizedThing: $bead, category: $label);
