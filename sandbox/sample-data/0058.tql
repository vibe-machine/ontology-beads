match $feature isa Bead, has beadId "one-40"; $gate isa Bead, has beadId "one-41"; $old isa Bead, has beadId "one-42"; $note isa Bead, has beadId "one-43"; $check isa Bead, has beadId "one-46"; $again isa Bead, has beadId "one-48"; $writer isa Bead, has beadId "one-45"; insert tracks (referringThing: $feature, referent: $writer), has linkCreatedBy "dana", has linkCreatedAt 2026-11-19T11:00:00; relatesTo (referringThing: $feature, referent: $note), has linkCreatedBy "dana", has linkCreatedAt 2026-11-19T11:01:00; validates (recognizingParty: $feature, recognizedThing: $old), has linkCreatedBy "dana", has linkCreatedAt 2026-11-19T11:02:00; duplicates (referringThing: $again, referent: $feature), has linkCreatedBy "companion", has linkCreatedAt 2026-11-19T11:03:00; causedBy (triggeredThing: $check, triggeringEvent: $old), has linkCreatedBy "agent-3", has linkCreatedAt 2026-11-19T11:04:00; delegatedFrom (derivedThing: $writer, basis: $feature), has linkCreatedBy "dana", has linkCreatedAt 2026-11-19T11:05:00; waitsFor (requiringThing: $gate, requirement: $feature), has waitGate "all-children", has linkCreatedBy "dana", has linkCreatedAt 2026-11-19T11:06:00; activeUntil (affectedThing: $note, effectSource: $feature), has linkCreatedBy "dana", has linkCreatedAt 2026-11-19T11:07:00;
