match $type isa BeadType, has name "task"; $status isa BeadStatus, has name "closed"; $priority isa Priority, has name "P3"; insert $bead isa Bead, has beadId "one-17", has title "Old dispatch script", has createdAt 2026-07-01T09:00:00, has closedAt 2026-11-16T09:30:00, has closeReason "Superseded by one-14"; isCategorizedBy (categorizedThing: $bead, category: $type); isCategorizedBy (categorizedThing: $bead, category: $status); isCategorizedBy (categorizedThing: $bead, category: $priority);
