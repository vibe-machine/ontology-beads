match $repo isa BeadRepository, has name "Exile"; $type isa BeadType, has name "task"; $status isa BeadStatus, has name "closed"; $priority isa Priority, has name "P2"; insert $bead isa Bead, has beadId "one-4", has title "Port save files to the new format", has createdAt 2026-06-01T09:00:00, has closedAt 2026-10-01T12:00:00, has closeReason "Done"; isCategorizedBy (categorizedThing: $bead, category: $type); isCategorizedBy (categorizedThing: $bead, category: $status); isCategorizedBy (categorizedThing: $bead, category: $priority); isMemberOf (member: $bead, collection: $repo);
