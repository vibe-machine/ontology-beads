match $bead isa Bead, has beadId "one-3"; $kind isa HistoryEntryType, has name "label_added"; insert $entry isa HistoryEntry, has actor "robert@example.com", has newValue "ux", has createdAt 2026-08-11T09:00:00; isAbout (content: $entry, subjectMatter: $bead); isCategorizedBy (categorizedThing: $entry, category: $kind);
